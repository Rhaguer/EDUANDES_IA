# Copia este archivo a .env y completa tu API Key antes de desplegar:
#   cp .env.example .env
#   docker compose up -d --build

HOST_PORT=8000
PORT=8000

# Motor Groq (compatible con OpenAI)
EDUCORE_ENGINE=openai_compat
EDUCORE_LLM_BASE_URL=https://api.groq.com/openai/v1
EDUCORE_LLM_API_KEY=gsk_reemplaza_con_tu_api_key
EDUCORE_LLM_MODEL=qwen/qwen3.8-27b
